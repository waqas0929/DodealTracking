# Copy to keystore.properties (gitignored) and fill in real values.
# Each Dodeal app has its OWN permanent keystore, stored OUTSIDE the repo (e.g. ~/.dodeal-signing/).
# Only the app being built needs its own entries present.

# --- Dodeal Tracking (com.dodeal.deviceagent) ---
tracking.storeFile=/absolute/path/OUTSIDE/repo/dodeal-tracking-release.jks
tracking.storePassword=CHANGE_ME
tracking.keyAlias=dodeal-tracking
tracking.keyPassword=CHANGE_ME

# --- Dodeal Updater (com.dodeal.updater) ---
updater.storeFile=/absolute/path/OUTSIDE/repo/dodeal-updater-release.jks
updater.storePassword=CHANGE_ME
updater.keyAlias=dodeal-updater
updater.keyPassword=CHANGE_ME
